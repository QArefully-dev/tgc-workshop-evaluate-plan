{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qme-418:grading:v3",
  "title": "Raw v3 grader report; semantic validation and totals by tools/grading.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "input_hashes", "quality", "compliance", "efficiency"],
  "properties": {
    "version": {"const": "v3"},
    "run_id": {"$ref": "#/$defs/text"},
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan-grading-template.md", "rubric-v3.json", "report-schema.json", "grader-instructions.md", "prompt.md", "ticket.md", "candidate.md", "source-snapshot"],
      "properties": {
        "plan-grading-template.md": {"$ref": "#/$defs/hash"},
        "rubric-v3.json": {"$ref": "#/$defs/hash"},
        "report-schema.json": {"$ref": "#/$defs/hash"},
        "grader-instructions.md": {"$ref": "#/$defs/hash"},
        "prompt.md": {"$ref": "#/$defs/hash"},
        "ticket.md": {"$ref": "#/$defs/hash"},
        "candidate.md": {"$ref": "#/$defs/hash"},
        "source-snapshot": {"$ref": "#/$defs/hash"}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["results", "improvements"],
      "properties": {
        "results": {"type": "array", "minItems": 41, "maxItems": 41, "items": {"$ref": "#/$defs/result"}},
        "improvements": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "compliance": {
      "type": "object", "additionalProperties": false,
      "required": ["rules", "eligibility"],
      "properties": {
        "rules": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/rule"}},
        "eligibility": {"enum": ["eligible", "ineligible", "unknown"]}
      }
    },
    "efficiency": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_seconds", "tokens", "cost", "evidence"],
      "properties": {
        "duration_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"const": "unknown"}]},
        "tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "unknown"}]},
        "cost": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "weight", "status", "evidence", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^(C(0[1-9]|[12][0-9]|3[01])|S(0[1-9]|10))$"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 5},
        "status": {"enum": ["met", "missing", "incorrect", "blocked"]},
        "evidence": {"$ref": "#/$defs/text"},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["assertion_id", "scenario", "evidence", "expectation", "prerequisites"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/text"},
        "scenario": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"},
        "expectation": {"enum": ["required_behavior", "product_defect_expected"]},
        "prerequisites": {"type": "array", "items": {"$ref": "#/$defs/prerequisite"}}
      }
    },
    "prerequisite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"enum": ["guest_entry", "base_selectable", "ingredients_selectable", "normal_admissible", "cart_add_path", "initial_and_changed_admissible", "food_admissible", "nonfood_admissible", "evaluable_rejection", "correction_admissible", "existing_saved_line", "edit_admissible"]},
        "status": {"enum": ["satisfied", "invalid_authored_setup", "unknown"]},
        "evidence": {"$ref": "#/$defs/text"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"enum": ["english", "word_limit", "headings", "scenario_limit", "output_path", "static_reads_only", "relevant_code_and_tests_read", "no_external_access", "no_browser_or_app", "no_test_execution", "no_install_or_reset", "no_subagents", "no_user_questions", "authorized_edits_only"]},
        "status": {"enum": ["met", "violated", "unknown"]},
        "evidence": {"$ref": "#/$defs/text"}
      }
    }
  }
}
